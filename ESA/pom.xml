<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>za.co.sindi.llm</groupId>
		<artifactId>sindi-langchain4j-liberty-bundle</artifactId>
		<version>0.0.1-SNAPSHOT</version>
	</parent>
	<artifactId>${esa.artifact.id}</artifactId>
	<packaging>esa</packaging>
	
	<dependencies>
		<dependency>
			<groupId>za.co.sindi.llm</groupId>
			<artifactId>${integration.artifact.id}</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- https://mvnrepository.com/artifact/io.openliberty.features/microProfile-6.1 -->
		<dependency>
		    <groupId>io.openliberty.features</groupId>
		    <artifactId>microProfile-6.1</artifactId>
		    <version>24.0.0.8</version>
		    <type>esa</type>
		    <scope>provided</scope>
		</dependency>
		<dependency>
		    <groupId>dev.langchain4j</groupId>
		    <artifactId>langchain4j</artifactId>
		    <version>${dev.langchain4j.version}</version>
		</dependency>
		<dependency>
			<groupId>za.co.sindi</groupId>
			<artifactId>sindi-langchain4j-cdi-portable-extension</artifactId>
			<version>0.0.1-SNAPSHOT</version>
		</dependency>
	</dependencies>
	
	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.aries</groupId>
			        <artifactId>esa-maven-plugin</artifactId>
			        <version>1.0.2</version>
			        <extensions>true</extensions>
			        <configuration>
			        	<generateManifest>true</generateManifest>
			        	<archiveContent>all</archiveContent>
			        	<instructions>
			        		<Subsystem-Vendor>IBM</Subsystem-Vendor>
            				<IBM-Feature-Version>2</IBM-Feature-Version>
            				<IBM-ShortName>${feature.name}</IBM-ShortName>
            				<Subsystem-SymbolicName>
						        ${integration.artifact.id};visibility:=public
						    </Subsystem-SymbolicName>
            				<Subsystem-Type>osgi.subsystem.feature</Subsystem-Type>
    						<Subsystem-Version>1.0.0</Subsystem-Version>
    						<IBM-API-Package>
								dev.langchain4j.memory.chat;version="${dev.langchain4j.version}",dev.langchain4j.model.chat;version="${dev.langchain4j.version}",dev.langchain4j.rag.content.retriever;version="${dev.langchain4j.version}",dev.langchain4j.service;version="${dev.langchain4j.version}",dev.langchain4j.service.sindi;version="1.0.0",za.co.sindi.langchain4j.spi.cdi.extension;version="1.0.0"
    						</IBM-API-Package>
    						<IBM-Test-Feature>true</IBM-Test-Feature>
			        	</instructions>
        			</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
		
		<plugins>
			<plugin>
				<groupId>org.apache.aries</groupId>
			   	<artifactId>esa-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
</project>